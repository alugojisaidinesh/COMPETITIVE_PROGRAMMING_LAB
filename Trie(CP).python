# Enter your code here. Read input from STDIN. Print output to STDOUT
class TrieNode:
    def __init__(self):
        self.children = {}
        self.end = False

class Trie:
    def __init__(self):
        self.root = TrieNode()
    def insert(self, word):
        node = self.root
        for ch in word:
            if ch not in node.children:
                node.children[ch] = TrieNode()
            node = node.children[ch]
        node.end = True
    def search(self, word):
        node = self.root
        for ch in word:
            if ch not in node.children:
                return 0
            node = node.children[ch]
        if node.end:
            return 1
        return 0
n = int(input())
keys = input().split(',')
search = input().strip()
trie = Trie()
for word in keys:
    trie.insert(word.strip())
print(trie.search(search))
